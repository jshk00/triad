# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.cov
test-output.txt
coverage.html

# env file
.env

# neovim files
*.vim

# python virtual env
env
